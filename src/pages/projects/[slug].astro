---
import fs from 'node:fs';
import path from 'node:path';
import Sub from '../../layouts/Sub.astro';
import Img from '../../components/Img.astro';
import Cta from '../../components/Cta.astro';
import { content } from '../../lib/content.mjs';
import { paras, imgUrl, tagOf, ver } from '../../lib/util.mjs';
import { breadcrumbs, projectLd, projectTitle, projectDescription, projectServices, pagesForProject } from '../../lib/seo.mjs';

export async function getStaticPaths() {
  const { projects } = await content();
  return projects.map((p, i) => ({ params: { slug: p.slug.current }, props: { p, next: projects[(i + 1) % projects.length] } }));
}
const { p, next } = Astro.props;
const all = await content();
const { projectsPage: pp, settings, projects, markets } = all;
const specs = pagesForProject(all, p);
const svc = projectServices(p);
const sameCity = projects.filter(x => x !== p && x.city === p.city).slice(0, 8);
const market = markets.find(m => (m.projects || []).some(x => x._id === p._id));
const ld = [breadcrumbs(settings, [['Home', ''], ['Projects', 'projects/index.html'], [p.name, `projects/${p.slug.current}.html`]]), projectLd(settings, p)];
const pre = '../';
const tag = tagOf(p.heroImage);
const hcls = tag === 'Drawing' ? 'phero dwg' : tag === 'Illustration' ? 'phero illus' : 'phero';
const gal = p.gallery || [];
// Optional looping hero film (real project footage): AV1 for browsers that play it, H.264 for the rest. The photo stays underneath as the poster.
// Optional labelled cutaway illustration (SVG in public/media), shown as "Under the street".
let cut = null;
if (p.cutaway?.svg) { try { cut = { ...p.cutaway, svg: fs.readFileSync(path.join(process.cwd(), 'public/media', p.cutaway.svg), 'utf8') }; } catch {} }
const hv = p.heroVideo?.mp4 ? { mp4: `${pre}media/${p.heroVideo.mp4}${ver(p.heroVideo.mp4)}`, av1: p.heroVideo.av1 ? `${pre}media/${p.heroVideo.av1}${ver(p.heroVideo.av1)}` : '' } : null;
---
<Sub path={`projects/${p.slug.current}.html`} title={p.name} fullTitle={projectTitle(settings, p)} description={projectDescription(p)} jsonld={ld} ogImage={imgUrl(p.heroImage)} active="projects" pre={pre}>
<header class={hcls}>
  <div class={`bg${tag === 'Illustration' ? ' ill' : ''}`}><Img image={p.heroImage} pre={pre} eager />{hv && <video class="hvid" muted playsinline loop preload="none" aria-hidden="true" data-mp4={hv.mp4} data-av1={hv.av1}></video>}</div>{tag && <span class="ill-tag mono">{tag}</span>}
  <div class="wrap ph-in">
    <a class="back" href="index.html">← All projects</a>
    <div class="top"><span class="chip"><span class={`d ${p.live ? 'o' : ''}`}></span>{p.status}</span><span class="chip">{p.type}</span><span class="chip">{p.city}</span></div>
    <h1>{p.name}</h1>
    <p class="ph-sub">{[p.type, p.city, p.year].filter(Boolean).join(' · ')}</p>
  </div>
  {hcls === 'phero' && <span class="nsc-badge"><img src={`${pre}nsc-logo.jpg`} alt="">NSC built</span>}
</header>
<main>
<div class="wrap"><dl class="fields">{(p.details || []).map(f => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}</dl></div>
<section class="sec">
  <div class="wrap">
    <div class="story">
      <div class="body">
        <p class="mono kick">About the project</p>
        <p class="lede">{p.lede}</p>
        {paras(p.body).map(t => <p>{t}</p>)}
      </div>
      {p.scope?.length > 0 && <aside class="scope rv"><h2>Scope of work</h2><ol>{p.scope.map(s => <li>{s}</li>)}</ol></aside>}
    </div>
    {p.facts?.length > 0 && <div class="facts">{p.facts.map(f => <div class="fact rv"><b>{f.value}</b><span>{f.label}</span></div>)}</div>}
    {p.timeline?.length > 0 && <div class="tl"><p class="mono kick">How the job ran</p><ol>{p.timeline.map(t => <li class="rv"><b>{t.when}</b><span>{t.what}</span></li>)}</ol></div>}
  </div>
</section>
{cut && <section class="sec cutsec" style="padding-top:0" aria-labelledby="cut-h"><div class="wrap">
  <p class="mono kick">Under the street</p>
  <h2 id="cut-h" style="font-size:clamp(1.8rem,1rem + 2.6vw,3.4rem);margin-top:18px">{cut.title || 'What we built underground.'}</h2>
  <figure class="cutaway rv"><div class="cut-art" set:html={cut.svg} /><figcaption class="mono">Illustration, not to scale. Numbers match the list below.</figcaption></figure>
  {cut.items?.length > 0 && <ol class="cut-list">{cut.items.map((t, i) => <li class="rv"><b>{i + 1}</b><span>{t}</span></li>)}</ol>}
</div></section>}
{gal.length > 0 && <section class="sec" style="padding-top:0"><div class="wrap"><p class="mono kick">On site</p>
  <h2 style="font-size:clamp(1.8rem,1rem + 2.6vw,3.4rem);margin-top:18px">From the field.</h2><div class="gal" id="gal">
  {gal.map(g => <button type="button" class="rv" data-full={imgUrl(g, pre, 2560)} aria-label={`Open image: ${g.alt || ''}`}><Img image={g} pre={pre} sizes="(max-width:700px) 100vw, 33vw" />{tagOf(g) && <span class="g-tag mono">{tagOf(g)}</span>}</button>)}
  </div></div></section>}
{(svc.length > 0 || specs.length > 0 || sameCity.length > 0 || market) && <section class="sec related" style="padding-top:0"><div class="wrap rel-g">
  {svc.length > 0 && <div><h2 class="mono rel-h">Services on this project</h2><div class="plinks">{svc.map(x => <a href={`../services.html#${x.anchor}`}>{x.label}<b>↗</b></a>)}</div></div>}
  {specs.length > 0 && <div><h2 class="mono rel-h">Related specialties</h2><div class="plinks">{specs.map(x => <a href={`../${x.slug.current}.html`}>{x.title}<b>↗</b></a>)}</div></div>}
  {sameCity.length > 0 && <div><h2 class="mono rel-h">More projects in {p.city}</h2><div class="plinks">{sameCity.map(x => <a href={`${x.slug.current}.html`}>{x.live && <i></i>}{x.shortName || x.name}<b>↗</b></a>)}</div></div>}
  {market && <div><h2 class="mono rel-h">Market</h2><div class="plinks"><a href={`../markets.html#${market.anchor}`}>{market.title}<b>↗</b></a></div></div>}
</div></section>}
{next && next !== p && <section>
  <div class="wrap">
    <a class="next" href={`${next.slug.current}.html`}><span class="mono">Next project</span><h2>{next.name} <span class="ar">→</span></h2></a>
  </div>
</section>}
<Cta pre={pre} title={pp.ctaTitle || 'Planning a similar project?'} text={pp.ctaText} bidLink="../contact.html" />
</main>
<div slot="after">{hv && <script is:inline>(()=>{const v=document.querySelector('.phero .hvid');if(!v||matchMedia('(prefers-reduced-motion: reduce)').matches||(navigator.connection&&navigator.connection.saveData))return;const go=()=>{v.src=v.dataset.av1&&v.canPlayType('video/mp4; codecs="av01.0.08M.08"')?v.dataset.av1:v.dataset.mp4;v.addEventListener('playing',()=>v.classList.add('on'),{once:true});v.play().catch(()=>{})};document.readyState==='complete'?go():addEventListener('load',go,{once:true})})()</script>}{gal.length > 0 && <div class="lb" id="lb" role="dialog" aria-modal="true" aria-label="Photo viewer"><img alt=""><button type="button" class="x">Close ✕</button><button type="button" class="pv" aria-label="Previous">←</button><button type="button" class="nx" aria-label="Next">→</button></div>}</div>
</Sub>
