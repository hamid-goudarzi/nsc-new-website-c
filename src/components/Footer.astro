---
import { tel } from '../lib/util.mjs';
const { settings: s, pages = [], pre = '' } = Astro.props;
const extra = pages.filter(p => p.showInFooter);
const year = new Date().getFullYear();
---
<footer class="pfoot">
  <div class="wrap">
    <div class="pf-g">
      <div class="pf-brand"><a class="logo" href={`${pre}index.html`}><img src={`${pre}nsc-logo.jpg`} alt=""><b>{s.companyName}</b></a>
        <p>{s.footerBlurb}</p>
        {s.corLine && <span class="pf-cor"><b>COR</b> {s.corLine.replace(/^COR\s*/, '')}</span>}</div>
      <div><h4>Company</h4><a href={`${pre}about.html`}>About</a><a href={`${pre}about.html#leadership`}>Leadership</a><a href={`${pre}safety.html`}>Safety &amp; Environment</a><a href={`${pre}careers.html`}>Careers</a>{extra.map(p => <a href={`${pre}${p.slug.current}.html`}>{p.navLabel || p.title}</a>)}</div>
      <div><h4>Work</h4><a href={`${pre}markets.html`}>Markets</a><a href={`${pre}index.html#services`}>Services</a><a href={`${pre}projects/index.html`}>Projects</a><a href={`${pre}about.html#region`}>Where we work</a></div>
      <div><h4>Contact</h4><a href={`${pre}contact.html`}>Request a bid</a><a href={`${pre}contact.html#partners`}>Subcontractors &amp; suppliers</a><a href={tel(s.phone)}>{s.phone}</a><a href={`mailto:${s.email}`}>{s.email}</a></div>
      <div><h4>Offices</h4>{(s.offices || []).map(o => <p>{o.label}<br><Fragment set:html={String(o.address).split('\n').map(l => l.replace(/&/g, '&amp;').replace(/</g, '&lt;')).join('<br>')} /></p>)}</div>
    </div>
    <div class="pf-bar"><span>© {year} {s.companyName} All rights reserved.</span><span>{s.linkedin && <a href={s.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>}{s.linkedin && s.instagram && ' · '}{s.instagram && <a href={s.instagram} target="_blank" rel="noopener">Instagram ↗</a>}</span></div>
  </div>
</footer>
